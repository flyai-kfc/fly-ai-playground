# Normalize all text files and enforce LF for common source/text formats
* text=auto

# Explicitly force LF for markup and config files
*.md text eol=lf
*.markdown text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.txt text eol=lf
*.csv text eol=lf